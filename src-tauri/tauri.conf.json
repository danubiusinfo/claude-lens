{
  "$schema": "https://raw.githubusercontent.com/niceewen/tauri-v2-schema/main/tauri.conf.json",
  "productName": "ClaudeLens",
  "version": "0.1.0",
  "identifier": "com.claudelens.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": false,
    "windows": [
      {
        "title": "",
        "width": 1080,
        "height": 830,
        "minWidth": 1080,
        "minHeight": 830,
        "decorations": true,
        "resizable": true,
        "transparent": false,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Local telemetry dashboard for Claude Code",
    "longDescription": "ClaudeLens is a local-first dashboard for your Claude Code usage. It imports the JSONL transcripts from your ~/.claude directory and shows token spend, session history, plans and work logs. All data stays on your machine.",
    "copyright": "Copyright (c) 2026 ClaudeLens",
    "icon": [
      "icons/16x16.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
